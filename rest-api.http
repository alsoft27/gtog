### 19b — Comprobar que el registro rechazado no creo la cuenta
# @no-cookie-jar
POST {{baseUrl}}/api/auth/login
Accept: application/json
Cookie: XSRF-TOKEN={{gtogSmokeCsrf}}
X-XSRF-TOKEN: {{gtogSmokeCsrf}}
Content-Type: application/json

{
  "email": "blocked-{{gtogSmokeEmail}}",
  "password": "{{password}}"
}

> {%
    // Este login lleva CSRF valido: su 401 debe corresponder a credenciales inexistentes.
    client.test("19b the rejected registration did not create an account", function () {
        client.assert(response.status === 401, "Blocked registration unexpectedly created an account");
    });
%}

# B. Preparacion privada en 20; 21–26 son publicas, sin sesion, Cookie ni X-XSRF-TOKEN.

### 20 — Obtener opciones y preparar credencial del invitado
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{gtogSmokeEventId}}
Accept: application/json
Cookie: XSRF-TOKEN={{gtogSmokeCsrf}}; JSESSIONID={{gtogSmokeSession}}

> {%
    client.test("20 returns the hosts event", function () {
        client.assert(response.status === 200, "Expected 200 for the owner");
    });
    client.assert(response.status === 200, "Cannot prepare guest response options");
    const yes = response.body.responseOptions.find(option => option.countsAsAttendance === true);
    const no = response.body.responseOptions.find(option => option.countsAsAttendance === false);
    client.assert(!!yes && !!no, "Expected attendance and non-attendance options");
    const path = client.global.get("gtogSmokeInvitationPath1");
    client.assert(/^\/r\/[A-Za-z0-9_-]{43}$/.test(path), "Invalid stored invitation path");
    client.assert(!!response.body.hostId, "Missing host id for privacy checks");
    client.global.set("gtogSmokeOptionYes", yes.id);
    client.global.set("gtogSmokeOptionNo", no.id);
    client.global.set("gtogSmokeHostId", response.body.hostId);
    client.global.set("gtogSmokeToken1", path.replace(/^\/r\//, ""));
%}

### 21 — Pagina publica sin contactos ni identidad del anfitrion
# @no-cookie-jar
GET {{baseUrl}}/api/invitations/{{gtogSmokeToken1}}
Accept: application/json

> {%
    client.test("21 returns a private public projection", function () {
        client.assert(response.status === 200, "Expected 200 without session or CSRF");
        client.assert(response.headers.valueOf("Cache-Control") === "no-store", "Expected exact no-store");
        client.assert(response.body.guest.name === "Ana María", "Unexpected guest name");
        const keys = Object.keys(response.body.guest);
        client.assert(keys.length === 1 && keys[0] === "name", "Guest must expose only name");
        const body = JSON.stringify(response.body);
        ["ana@example.com", "ana.maria@example.com", "+34612345678", "+34 612 345 678",
            client.global.get("gtogSmokeEmail"), client.global.get("gtogSmokeHostId")].forEach(function (secret) {
            client.assert(body.indexOf(secret) === -1, "Public body exposes a contact or the host id");
        });
        client.assert(body.indexOf("countsAsAttendance") === -1, "Public options must not expose attendance flags");
    });
%}

### 22 — Responder Asisto sin sesion ni CSRF
# @no-cookie-jar
PUT {{baseUrl}}/api/invitations/{{gtogSmokeToken1}}/response
Accept: application/json
Content-Type: application/json

{
  "responseOptionId": "{{gtogSmokeOptionYes}}",
  "email": "respuesta-privada@example.com"
}

> {%
    client.test("22 accepts a public response without exposing its email", function () {
        client.assert(response.status === 200, "Expected 200 without session or CSRF");
        client.assert(!!response.body.myResponse, "Missing myResponse");
        client.assert(response.body.myResponse.responseOptionId === client.global.get("gtogSmokeOptionYes"), "Unexpected response option");
        client.assert(!("email" in response.body.myResponse), "myResponse must not expose email");
        client.assert(JSON.stringify(response.body.myResponse).indexOf("respuesta-privada@example.com") === -1, "myResponse exposes private email");
        client.assert(JSON.stringify(response.body).indexOf("respuesta-privada@example.com") === -1, "Public body exposes private email");
        client.assert(response.headers.valueOf("Cache-Control") === "no-store", "Expected exact no-store");
    });
%}


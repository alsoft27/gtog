%}

### 14 — Comprobar que solo queda la primera invitada
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{gtogSmokeEventId}}/guests
Accept: application/json
Cookie: XSRF-TOKEN={{csrf}}; JSESSIONID={{gtogSmokeSession}}

> {%
    client.test("14 returns 200", function () {
        client.assert(response.status === 200, "Unexpected HTTP status: " + response.status);
    });
    client.assert(response.status === 200, "Cannot continue this step: unexpected status");
    client.test("14 satisfies functional expectations", function () {
        client.assert(response.body.length === 1, "Expected one remaining guest");
        client.assert(response.body[0].id === client.global.get("gtogSmokeGuest1"), "Wrong guest remains");
        client.assert(response.body[0].name === "Ana María", "Remaining guest changed");
    });
%}

### 15 — Publicar el evento
# @no-cookie-jar
POST {{baseUrl}}/api/events/{{gtogSmokeEventId}}/publish
Accept: application/json
Cookie: XSRF-TOKEN={{csrf}}; JSESSIONID={{gtogSmokeSession}}
X-XSRF-TOKEN: {{csrf}}

> {%
    client.test("15 returns 200", function () {
        client.assert(response.status === 200, "Unexpected HTTP status: " + response.status);
    });
    client.assert(response.status === 200, "Cannot continue this step: unexpected status");
    client.test("15 satisfies functional expectations", function () {
        client.assert(response.body.status === "PUBLISHED", "Event was not published");
        client.assert(response.body.title === "Evento de prueba actualizado", "Updated event title was lost");
    });
%}

### 16 — Confirmar invitada conservada tras publicar
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{gtogSmokeEventId}}/guests
Accept: application/json
Cookie: XSRF-TOKEN={{csrf}}; JSESSIONID={{gtogSmokeSession}}

> {%
    client.test("16 returns 200", function () {
        client.assert(response.status === 200, "Unexpected HTTP status: " + response.status);
    });
    client.assert(response.status === 200, "Cannot continue this step: unexpected status");
    client.test("16 satisfies functional expectations", function () {
        client.assert(response.body.length === 1, "Publication changed the guest list");
        client.assert(response.body[0].id === client.global.get("gtogSmokeGuest1"), "Publication lost the guest");
        client.assert(response.body[0].invitationPath === client.global.get("gtogSmokeInvitationPath1"), "Publication changed the invitation link");
    });
%}

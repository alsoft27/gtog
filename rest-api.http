        const totals = JSON.parse(client.global.get("gtogSmokeDashboardTotals"));
        client.assert(!!summary, "Missing event summary");
        client.assert(summary.totalGuests === totals.guests && summary.answered === totals.answered
            && summary.pending === totals.pending && summary.attending === totals.attending, "Listing and dashboard totals differ");
        client.assert(!("byOption" in summary), "Listing must not include option breakdown");
    });
%}


# Recorrido funcional R1–R9: evento, invitados, respuesta publica y panel (no exhaustivo).
# Arranca tu el backend. Ejecuta 00–33 en orden con las flechas verdes del HTTP Client.
# Solo si todas las pruebas anteriores pasan, ejecuta el bloque opcional 34–37.
# Run All Requests tambien ejecuta el bloque opcional; no lo uses para omitir esa revision.
# No requiere un environment de IntelliJ. Las letras a/b/c son llamadas del mismo paso.
# Cada ejecucion completa registra dos cuentas nuevas y guarda datos en gtog_dev.
# Las variables gtogSmoke* se rellenan al recibir las respuestas, sin copiar ids a mano.
# Al terminar queda un evento CANCELLED con Ana y su respuesta; el primero cierra sesion.
# El bloque opcional deja ademas un evento ONLINE publicado del segundo anfitrion.
# No se envian invitaciones ni correos; el email de respuesta solo se guarda.
#
# CSRF: 00 obtiene la cookie del servidor y guarda su valor en gtogSmokeCsrf.
# El anfitrion envia ese valor crudo en XSRF-TOKEN y X-XSRF-TOKEN; las invitaciones no lo envian.
# Se desactiva el cookie jar por peticion y se envia la sesion explicitamente para evitar
# interferencias con otras pruebas abiertas en IntelliJ. No imprimir ni versionar sesiones.
# Registro y login estan incluidos como preparacion del recorrido.
# Los logs de 01, 02 y 18 observan Set-Cookie sin imprimir sus valores ni exigir rotacion.
# Antes solo se emitia al rechazar CSRF; ahora se exige tambien en el primer GET (00 y 18).
#
# Lo que este archivo no verifica:
# - Integracion del frontend con el bootstrap CSRF; aqui se comprueba solo el contrato HTTP.
# - Politicas del navegador (CORS, SameSite, Secure, HttpOnly), Referer y Referrer-Policy.
# - Interfaz, mapa, conversion de zona del invitado e importacion real del .ics en su agenda.
# - Concurrencia, indices, numero de consultas, version o limpieza de respuestas huerfanas.
# - Todos los limites de dominio: plazo/fin exactos, DRAFT/FINISHED y otros modos de visibilidad.
# Esas comprobaciones requieren navegador, tests dedicados o inspeccion de persistencia.

@baseUrl = http://localhost:8080
@password = SmokeTest2026!

### 00 — Obtener cookie CSRF antes del registro
# @no-cookie-jar
< {%
    client.global.clear("gtogSmokeCsrf");
%}
GET {{baseUrl}}/actuator/health
Accept: application/json

> {%
    const csrfCookie = response.cookiesByName("XSRF-TOKEN")[0];
    client.test("00 issues the CSRF cookie on the first GET", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(!!csrfCookie && !!csrfCookie.value, "Missing initial CSRF cookie");
    });
    client.assert(response.status === 200 && !!csrfCookie && !!csrfCookie.value, "Cannot bootstrap CSRF");
    client.global.set("gtogSmokeCsrf", csrfCookie.value);
%}

### 01 — Registrar anfitrion de prueba
# @no-cookie-jar
< {%
    const suffix = Date.now().toString();
    client.global.set("gtogSmokeEmail", "host-smoke-" + suffix + "@example.com");
    ["gtogSmokeSession", "gtogSmokeEventId", "gtogSmokeGuest1", "gtogSmokeGuest2", "gtogSmokeInvitationPath1",
        "gtogSmokeStartsAt", "gtogSmokeEndsAt", "gtogSmokeHostId", "gtogSmokeOptionYes", "gtogSmokeOptionNo",
        "gtogSmokeToken1", "gtogSmokeUnknownToken", "gtogSmokeDashboardTotals", "gtogSmokeEmail2",
        "gtogSmokeSession2", "gtogSmokeOnlineEventId", "gtogSmokeOnlineOptionYes", "gtogSmokeOnlineOptionNo",
        "gtogSmokeOnlineToken"].forEach(function (name) {
        client.global.clear(name);
    });
    // Siete dias naturales desde hoy, sin convertir la fecha local a UTC.
    const eventDate = new Date();
    eventDate.setDate(eventDate.getDate() + 7);
    const date = eventDate.getFullYear() + "-" + String(eventDate.getMonth() + 1).padStart(2, "0")
        + "-" + String(eventDate.getDate()).padStart(2, "0");
    client.global.set("gtogSmokeStartsAt", date + "T18:00:00");
    client.global.set("gtogSmokeEndsAt", date + "T20:00:00");
    client.global.set("gtogSmokeUnknownToken", "A".repeat(43));
%}
POST {{baseUrl}}/api/auth/register
Accept: application/json
Cookie: XSRF-TOKEN={{gtogSmokeCsrf}}
X-XSRF-TOKEN: {{gtogSmokeCsrf}}
Content-Type: application/json

{
  "name": "Anfitrión prueba simple",
  "email": "{{gtogSmokeEmail}}",
  "rawPassword": "{{password}}",
  "timeZone": "Europe/Madrid"
}

> {%
    client.log("01 cookie XSRF-TOKEN en respuesta: " + (response.cookiesByName("XSRF-TOKEN").length > 0 ? "sí" : "no"));
    client.test("01 returns 201", function () {
        client.assert(response.status === 201, "Unexpected HTTP status: " + response.status);
    });
    client.assert(response.status === 201, "Cannot continue this step: unexpected status");
    client.test("01 satisfies functional expectations", function () {
        client.assert(!!response.body.id, "Missing host id");
        client.assert(response.headers.valueOf("Location") === "/api/users/" + response.body.id, "Unexpected Location");
        client.assert(!("passwordHash" in response.body), "Password hash must not be exposed");
    });
%}

### 02 — Iniciar sesion
# @no-cookie-jar
POST {{baseUrl}}/api/auth/login
Accept: application/json
Cookie: XSRF-TOKEN={{gtogSmokeCsrf}}
X-XSRF-TOKEN: {{gtogSmokeCsrf}}
Content-Type: application/json

{
  "email": "{{gtogSmokeEmail}}",
  "password": "{{password}}"
}

> {%
    const xsrfCookie = response.cookiesByName("XSRF-TOKEN")[0];
    const sentCsrf = request.headers.findByName("X-XSRF-TOKEN").value();
    client.log("02 cookie XSRF-TOKEN en respuesta: " + (xsrfCookie ? "sí" : "no")
        + "; valor distinto del enviado: " + (xsrfCookie ? (xsrfCookie.value !== sentCsrf ? "sí" : "no") : "no comparable (sin cookie)"));
    client.test("02 returns 200", function () {
        client.assert(response.status === 200, "Unexpected HTTP status: " + response.status);
    });
    client.assert(response.status === 200, "Cannot continue this step: unexpected status");
    const session = response.cookiesByName("JSESSIONID")[0];
    client.assert(!!session, "Login did not return JSESSIONID");
    client.global.set("gtogSmokeSession", session.value);
%}

### 03 — Crear evento presencial
# @no-cookie-jar
POST {{baseUrl}}/api/events
Accept: application/json
Cookie: XSRF-TOKEN={{gtogSmokeCsrf}}; JSESSIONID={{gtogSmokeSession}}
X-XSRF-TOKEN: {{gtogSmokeCsrf}}
Content-Type: application/json

{
  "title": "Evento de prueba simple",
  "description": "Creación y gestión de invitados",
  "startsAt": "{{gtogSmokeStartsAt}}",
  "endsAt": "{{gtogSmokeEndsAt}}",
  "timeZone": "Europe/Madrid",
  "modality": "IN_PERSON",
  "venue": {
    "placeName": "Sala de prueba",
    "address": "Calle de prueba 1, Madrid",
    "latitude": 40.4168,
    "longitude": -3.7038,
    "placeId": "manual-place-id",
    "directions": "Entrada principal"
  }
}

> {%
    client.test("03 returns 201", function () {
        client.assert(response.status === 201, "Unexpected HTTP status: " + response.status);
    });
    client.assert(response.status === 201, "Cannot continue this step: unexpected status");
    client.test("03 satisfies functional expectations", function () {
        client.assert(response.body.status === "DRAFT", "Event must start as DRAFT");
        client.assert(response.body.responseOptions.length === 2, "Expected default response options");
        client.assert(response.headers.valueOf("Location") === "/api/events/" + response.body.id, "Unexpected Location");
    });
    client.global.set("gtogSmokeEventId", response.body.id);
%}


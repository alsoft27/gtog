### 34a — Crear evento ONLINE con acceso ON_CONFIRMATION
# @no-cookie-jar
POST {{baseUrl}}/api/events
Accept: application/json
Cookie: XSRF-TOKEN={{gtogSmokeCsrf}}; JSESSIONID={{gtogSmokeSession2}}
X-XSRF-TOKEN: {{gtogSmokeCsrf}}
Content-Type: application/json

{
  "title": "Sala virtual de prueba",
  "description": "Visibilidad del enlace segun la asistencia",
  "startsAt": "{{gtogSmokeStartsAt}}",
  "endsAt": "{{gtogSmokeEndsAt}}",
  "timeZone": "Europe/Madrid",
  "modality": "ONLINE",
  "allowResponseChange": true,
  "onlineAccess": {
    "platform": "Smoke meeting",
    "url": "https://meet.example.com/gtog-smoke",
    "linkVisibility": "ON_CONFIRMATION"
  }
}

> {%
    client.test("34a creates an online draft", function () {
        client.assert(response.status === 201, "Expected 201");
        client.assert(response.body.status === "DRAFT" && response.body.modality === "ONLINE", "Expected ONLINE draft");
    });
    client.assert(response.status === 201, "Cannot prepare optional event");
    const yes = response.body.responseOptions.find(option => option.countsAsAttendance === true);
    const no = response.body.responseOptions.find(option => option.countsAsAttendance === false);
    client.assert(!!yes && !!no, "Missing online response options");
    client.global.set("gtogSmokeOnlineEventId", response.body.id);
    client.global.set("gtogSmokeOnlineOptionYes", yes.id);
    client.global.set("gtogSmokeOnlineOptionNo", no.id);
%}


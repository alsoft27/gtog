### F8 — Listado sin sesion: deseado 401 ProblemDetail
# @no-cookie-jar
GET {{baseUrl}}/api/events
Accept: application/json

> {%
    client.log("F8 status obtenido: " + response.status + "; deseado: 401");
    client.test("F8 missing authentication is a 401 ProblemDetail", function () {
        client.assert(response.status === 401, "Desired 401; obtained " + response.status);
        client.assert(response.contentType.mimeType === "application/problem+json", "Expected ProblemDetail content type");
        client.assert(response.body.status === 401, "Expected ProblemDetail status 401");
        client.assert(response.body.instance === "/api/errors", "Expected constant error instance");
        client.assert(response.headers.valueOf("Cache-Control") === "no-store", "Expected exact no-store");
    });
%}

    client.test("33b the old session is no longer authenticated", function () {
        client.assert(response.status === 401, "Expected 401 for the logged-out session");
        client.assert(!!renewedCsrf && !!renewedCsrf.value, "GET after logout must issue a CSRF cookie");
        client.assert(renewedCsrf.value !== previousCsrf, "Expected a new CSRF cookie after logout");
    });
    client.assert(!!renewedCsrf && !!renewedCsrf.value, "Cannot refresh CSRF after logout");
    client.global.set("gtogSmokeCsrf", renewedCsrf.value);
%}


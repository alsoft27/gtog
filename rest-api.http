### 11 — Editar la primera invitada
# @no-cookie-jar
PUT {{baseUrl}}/api/events/{{gtogSmokeEventId}}/guests/{{gtogSmokeGuest1}}
Accept: application/json
Cookie: XSRF-TOKEN={{csrf}}; JSESSIONID={{gtogSmokeSession}}
X-XSRF-TOKEN: {{csrf}}
Content-Type: application/json

{
  "name": "Ana María",
  "email": "ana.maria@example.com",
  "phone": null
}

> {%
    client.test("11 returns 200", function () {
        client.assert(response.status === 200, "Unexpected HTTP status: " + response.status);
    });
    client.assert(response.status === 200, "Cannot continue this step: unexpected status");
    client.test("11 satisfies functional expectations", function () {
        client.assert(response.body.id === client.global.get("gtogSmokeGuest1"), "Guest identity changed");
        client.assert(response.body.name === "Ana María", "Name was not updated");
        client.assert(response.body.email === "ana.maria@example.com", "Email was not updated");
        client.assert(!("token" in response.body) && !("invitationPath" in response.body), "Edit must not expose invitation credentials");
    });
%}

### 12 — Comprobar edicion y estabilidad del enlace
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{gtogSmokeEventId}}/guests
Accept: application/json
Cookie: XSRF-TOKEN={{csrf}}; JSESSIONID={{gtogSmokeSession}}

> {%
    client.test("12 returns 200", function () {
        client.assert(response.status === 200, "Unexpected HTTP status: " + response.status);
    });
    client.assert(response.status === 200, "Cannot continue this step: unexpected status");
    client.test("12 satisfies functional expectations", function () {
        client.assert(response.body.length === 2, "Rejected additions must not create guests");
        const ana = response.body.find(g => g.id === client.global.get("gtogSmokeGuest1"));
        client.assert(!!ana && ana.name === "Ana María" && ana.email === "ana.maria@example.com", "Edit was not persisted");
        client.assert(ana.invitationPath === client.global.get("gtogSmokeInvitationPath1"), "Invitation link changed on edit");
    });
%}


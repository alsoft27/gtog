# C. Seguimiento privado y cancelacion; las consultas publicas siguen sin cookies.

### 27 — Panel del anfitrion tras cambiar a No asisto
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{gtogSmokeEventId}}/dashboard
Accept: application/json
Cookie: XSRF-TOKEN={{gtogSmokeCsrf}}; JSESSIONID={{gtogSmokeSession}}

> {%
    client.test("27 returns dashboard totals and preserves privacy", function () {
        client.assert(response.status === 200, "Expected 200");
        const totals = response.body.totals;
        client.assert(totals.guests === 1 && totals.answered === 1 && totals.pending === 0 && totals.attending === 0, "Unexpected dashboard totals");
        client.assert(response.body.guests.length === 1, "Expected one dashboard row");
        const ana = response.body.guests.find(guest => guest.id === client.global.get("gtogSmokeGuest1"));
        client.assert(!!ana && ana.name === "Ana María", "Missing Ana row");
        client.assert(ana.invitationStatus === "OPENED", "Public visit must mark OPENED");
        client.assert(ana.answered === true && ana.optionKnown === true, "Expected answer with a known option");
        client.assert(!!ana.response && ana.response.label === "No asisto", "Expected No asisto response");
        client.assert(response.headers.valueOf("Cache-Control") === "no-store", "Expected exact no-store");
        const body = JSON.stringify(response.body);
        client.assert(body.indexOf("respuesta-privada") === -1, "Dashboard exposes private response email");
        const token = client.global.get("gtogSmokeToken1");
        client.assert(body.split(token).length - 1 === 1, "Token must appear exactly once");
        client.assert(ana.invitationPath === "/r/" + token, "Token must appear inside invitationPath");
        client.assert(!/"(?:guestToken|token)"\s*:/.test(body), "Unexpected raw token key");
    });
    client.assert(response.status === 200, "Cannot store dashboard totals");
    client.global.set("gtogSmokeDashboardTotals", JSON.stringify(response.body.totals));
%}

### 28 — Contadores del listado coinciden con el panel
# @no-cookie-jar
GET {{baseUrl}}/api/events
